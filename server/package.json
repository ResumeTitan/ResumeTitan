        "@types/body-parser": "^1.19.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.11.16",
        "prisma": "4.5.0",
        "standard": "^17.0.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3"
    }
