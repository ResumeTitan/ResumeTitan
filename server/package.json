{
    "name": "server",
    "version": "1.0.0",
    "private": true,
    "main": "dist/index.js",
    "scripts": {
        "build": "npx tsc",
        "test": "echo \"Error: no test specified\" && exit 1",
        "start": "npx tsx src/index.ts",
        "start:prod": "node dist/index.js",
        "deploy:dev": "flyctl deploy -c fly-dev.toml",
        "deploy:prod": "flyctl deploy -c fly.toml",
        "clean": "rm -rf node_modules && rm package-lock.json",
        "clean:install": "rm -rf node_modules && rm package-lock.json && npm install",
        "setup:python": "cd scraper && python3 -m pip install -r requirements.txt",
        "test:scraper": "cd scraper && python3 test_scraper.py"
    },
    "nodemonConfig": {
        "delay": "1000"
    },
    "engineStrict": true,
    "overrides": {
        "secure-password": {
            "sodium-native": "3.3.0"
        }
    },
    "engines": {
        "node": "^21.6.2"
    },
    "dependencies": {
        "@clerk/backend": "^1.13.9",
        "@clerk/clerk-sdk-node": "^5.0.49",
        "@clerk/nextjs": "^5.7.2",
        "@emotion/react": "11.10.6",
        "@emotion/styled": "11.10.6",
        "@google-cloud/speech": "^5.4.0",
        "@google/generative-ai": "^0.2.1",
        "@prisma/client": "4.5.0",
        "@sentry/node": "^7.91.0",
        "@sentry/profiling-node": "^9.27.0",
        "@sparticuz/chromium": "^123.0.1",
        "@types/body-parser": "^1.19.5",
        "@types/cors": "^2.8.17",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.11",
        "axios": "^1.9.0",
        "bcrypt": "^5.1.0",
        "cheerio": "^1.0.0",
        "cookie-parser": "~1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "eslint": "~7.32.0",
        "express": "^4.21.1",
        "express-rate-limit": "^7.5.0",
        "ffmpeg-static": "^5.2.0",
        "fluent-ffmpeg": "^2.1.3",
        "framer-motion": "6.5.1",
        "got": "^14.4.1",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.0",
        "locate-chrome": "^0.1.1",
        "lodash.merge": "^4.6.2",
        "mongoose": "^8.1.1",
        "morgan": "^1.10.0",
        "multer": "^2.0.2",
        "node-cache": "^5.1.2",
        "node-fetch": "3.3.0",
        "passport": "0.6.0",
        "passport-google-oauth20": "2.0.0",
        "patch-package": "^6.4.7",
        "puppeteer": "^22.15.0",
        "styled-components": "^6.1.12",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@flydotio/dockerfile": "^0.2.16",
        "@tsconfig/node18": "^1.0.1",
        "@types/body-parser": "^1.19.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.11.16",
        "prisma": "4.5.0",
        "standard": "^17.0.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3"
    }
}
