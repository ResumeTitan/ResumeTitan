{
    "name": "server",
    "version": "0.1.0",
    "private": true,
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "test": "echo \"Error: no test specified\" && exit 1",
        "start": "tsx src/index.ts",
        "start:prod": "node dist/index.js",
        "deploy": "flyctl deploy",
        "clean": "rm -rf node_modules && rm package-lock.json",
        "clean:install": "rm -rf node_modules && rm package-lock.json && npm install"
    },
    "nodemonConfig": {
        "ignore": [
            "node_modules",
            "dist"
        ]
    },
    "engineStrict": true,
    "overrides": {
        "secure-password": {
            "sodium-native": "3.3.0"
        }
    },
    "engines": {
        "node": ">=20.11.1"
    },
    "dependencies": {
        "@clerk/backend": "^1.13.9",
        "@clerk/clerk-sdk-node": "^5.0.49",
        "@clerk/nextjs": "^5.7.2",
        "@emotion/react": "11.10.6",
        "@emotion/styled": "11.10.6",
        "@google/generative-ai": "^0.24.1",
        "@langchain/openai": "^0.0.14",
        "@prisma/client": "4.5.0",
        "@sparticuz/chromium": "^123.0.1",
        "axios": "^1.7.2",
        "bcrypt": "^5.1.0",
        "body-parser": "^1.20.2",
        "chatgpt": "^5.0.10",
        "chatgpt-prompts": "^2.0.1",
        "cookie-parser": "~1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.1",
        "eslint": "~7.32.0",
        "express": "^4.18.2",
        "framer-motion": "6.5.1",
        "got": "^14.4.1",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.0",
        "langchain": "^0.0.200",
        "locate-chrome": "^0.1.1",
        "lodash.merge": "^4.6.2",
        "mongoose": "^8.1.1",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "node-fetch": "3.3.0",
        "openai": "^4.104.0",
        "passport": "0.6.0",
        "passport-google-oauth20": "2.0.0",
        "patch-package": "^6.4.7",
        "puppeteer": "^19.11.1",
        "puppeteer-core": "^22.11.2",
        "secure-password": "^4.0.0",
        "stripe": "^15.8.0",
        "styled-components": "^6.1.8",
