        "typescript": "^5.3.3"
    },
    "overrides": {
        "typescript": "^5.3.3"
    },
    "scripts": {
        "start": "env-cmd -f .env.local react-scripts start",
        "start:prod": "env-cmd -f .env.production serve -s build",
        "build": "react-scripts build",
        "test": "react-scripts test",
        "eject": "react-scripts eject",
        "deploy:dev": "flyctl deploy -c fly-dev.toml",
        "deploy:prod": "flyctl deploy -c fly.toml",
        "clean": "rm -rf node_modules && rm package-lock.json",
        "clean:install": "rm -rf node_modules && rm package-lock.json && npm install"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@flydotio/dockerfile": "^0.2.14",
        "dotenv": "^16.4.5",
        "env-cmd": "^10.1.0",
        "react-scripts": "^5.0.1",
        "webpack": "^5.94.0",
        "webpack-cli": "^5.1.3"
    },
    "browser": {
        "fs": false,
        "path": false
    }
