        "@reduxjs/toolkit": "^1.8.6",
        "@sentry/react": "^9.28.1",
        "aos": "^3.0.0-beta.6",
        "axios": "^1.7.4",
        "dayjs": "^1.11.10",
        "dotenv-webpack": "^8.0.1",
        "html2pdf.js": "^0.10.3",
        "react": "^18.2.0",
        "react-beautiful-dnd": "^13.1.1",
        "react-dom": "^18.2.0",
        "react-icons": "^5.3.0",
        "react-markdown": "^10.1.0",
        "react-redux": "^8.0.4",
        "react-router-dom": "^6.14.1",
        "react-to-print": "^2.14.13",
        "recharts": "^3.1.0",
